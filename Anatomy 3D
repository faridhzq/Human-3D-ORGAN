const scene=new THREE.Scene();
scene.background=new THREE.Color(0x050914);
const camera=new THREE.PerspectiveCamera(43,innerWidth/innerHeight,.1,100);
camera.position.set(0,0.7,8.8);

const renderer=new THREE.WebGLRenderer({antialias:true,alpha:false});
renderer.setPixelRatio(Math.min(devicePixelRatio,2));
renderer.setSize(innerWidth,innerHeight);
renderer.outputColorSpace=THREE.SRGBColorSpace;
document.getElementById("app").appendChild(renderer.domElement);

const controls=new THREE.OrbitControls(camera,renderer.domElement);
controls.enableDamping=true; controls.dampingFactor=.07; controls.target.set(0,.1,0);
controls.minDistance=4.2; controls.maxDistance=13;
controls.enablePan=false;

scene.add(new THREE.HemisphereLight(0xbdd9ff,0x111827,2.2));
const key=new THREE.DirectionalLight(0xffffff,2.4); key.position.set(4,7,6); scene.add(key);
const rim=new THREE.DirectionalLight(0x6ea8ff,1.4); rim.position.set(-5,3,-5); scene.add(rim);

const body=new THREE.Group(); scene.add(body);
const clickable=[];
const skinMat=new THREE.MeshPhysicalMaterial({color:0xc77f6f,transparent:true,opacity:.14,roughness:.72,side:THREE.DoubleSide});
let skinVisible=true;

function mat(color,metal=0,rough=.55){
 return new THREE.MeshStandardMaterial({color,roughness:rough,metalness:metal,transparent:true});
}
function mesh(name,geo,material,pos,scale=[1,1,1]){
 const m=new THREE.Mesh(geo,material); m.name=name; m.position.set(...pos); m.scale.set(...scale); body.add(m); clickable.push(m); return m;
}
function sphere(name,pos,scale,color){
 return mesh(name,new THREE.SphereGeometry(1,32,20),mat(color,0,.45),pos,scale);
}
function capsule(name,pos,scale,color,rot=[0,0,0]){
 const m=mesh(name,new THREE.CapsuleGeometry(.5,1,12,24),mat(color,0,.5),pos,scale); m.rotation.set(...rot); return m;
}
function tube(name,a,b,r,color){
 const A=new THREE.Vector3(...a),B=new THREE.Vector3(...b),v=new THREE.Vector3().subVectors(B,A),len=v.length();
 const g=new THREE.CylinderGeometry(r,r,len,18);
 const m=mesh(name,g,mat(color,0,.55),[0,0,0]);
 m.position.copy(A).add(B).multiplyScalar(.5); m.quaternion.setFromUnitVectors(new THREE.Vector3(0,1,0),v.normalize());
 return m;
}
function torus(name,pos,major,minor,color,rot=[0,0,0]){
 const m=mesh(name,new THREE.TorusGeometry(major,minor,16,40),mat(color,0,.5),pos); m.rotation.set(...rot); return m;
}

// Stylised anatomical body silhouette
sphere("Skin",[0,0,0],[1.18,2.95,.62],0xc77f6f);
