// Ovaries (included as educational female reproductive structures)
sphere("Ovary (L)",[-.28,-.95,.25],[.12,.12,.1],0xd66a9c);
sphere("Ovary (R)",[.28,-.95,.25],[.12,.12,.1],0xd66a9c);

function setSkin(){
 skinVisible=!skinVisible;
 body.traverse(o=>{ if(o.isMesh && o.name==="Skin"){o.material.opacity=skinVisible?.14:0.02;}});
 toast(skinVisible?"Skin layer shown":"Skin layer hidden — explore internal organs");
}
function select(name){
 const d=data[name]; if(!d)return;
 document.getElementById("organTitle").textContent=name;
 document.getElementById("system").textContent=d[0];
 document.getElementById("description").textContent=d[1];
 document.getElementById("fact").textContent=d[2];
 document.getElementById("panel").classList.remove("hidden");
 // highlight
 clickable.forEach(o=>{if(o.material && o.name!=="Skin"){o.material.emissive?.set(0x000000);}});
 const target=clickable.find(o=>o.name===name);
 if(target && target.material.emissive) target.material.emissive.set(0x244b72);
}
document.getElementById("close").onclick=()=>document.getElementById("panel").classList.add("hidden");
document.getElementById("skin").onclick=setSkin;
document.getElementById("front").onclick=()=>{body.rotation.y=0;camera.position.set(0,.5,8.8);controls.target.set(0,.1,0);controls.update()};
document.getElementById("reset").onclick=()=>{body.rotation.set(0,0,0);camera.position.set(0,.7,8.8);controls.target.set(0,.1,0);controls.update();};
document.getElementById("systems").onclick=()=>toast("Organs are colour-coded by body system.");
function toast(t){const e=document.getElementById("toast");e.textContent=t;e.style.display="block";clearTimeout(window.tt);window.tt=setTimeout(()=>e.style.display="none",1800)}

const raycaster=new THREE.Raycaster(),pointer=new THREE.Vector2();
function pointerDown(e){
 const r=renderer.domElement.getBoundingClientRect();
 pointer.x=((e.clientX-r.left)/r.width)*2-1; pointer.y=-((e.clientY-r.top)/r.height)*2+1;
 raycaster.setFromCamera(pointer,camera);
 const hits=raycaster.intersectObjects(clickable,false);
 if(hits.length){select(hits[0].object.name);}
}
renderer.domElement.addEventListener("pointerup",pointerDown);

const search=document.getElementById("search");
search.addEventListener("input",()=>{
 const q=search.value.trim().toLowerCase();
 if(!q)return;
 const key=Object.keys(data).find(k=>k.toLowerCase().includes(q));
 if(key)select(key);
});
search.addEventListener("focus",()=>{if(innerWidth<=700){search.style.width="min(280px,70vw)";search.style.opacity="1";search.style.padding="0 40px 0 14px";}});
search.addEventListener("blur",()=>{if(innerWidth<=700 && !search.value){search.style.width="42px";search.style.opacity="0";search.style.padding="0";}});

addEventListener("resize",()=>{
 camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();
 renderer.setSize(innerWidth,innerHeight);
 renderer.setPixelRatio(Math.min(devicePixelRatio,2));
});
setTimeout(()=>document.getElementById("loading").style.display="none",650);

function animate(){requestAnimationFrame(animate);controls.update();renderer.render(scene,camera)}
animate();
</script>
</body>
